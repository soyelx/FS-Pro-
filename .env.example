# Copy to `.env` only if you need to override the defaults below.
# This repository has no secrets, API keys or services: both variables are
# optional and are read by the Python tooling in tools/.

# Directory containing the display/, text/, rounded/ and variable/ folders.
# Relative paths are resolved from the repository root.
FONTS_DIR=fonts

# Where `python -m tools.manifest` writes the generated font index.
MANIFEST_PATH=fonts/manifest.json
